{
    "name": "YouTube Notes",
    "version": "1.0.0",
    "description": "A Chrome extension that allows users to make notes for lectures available on YouTube.",
    "manifest_version": 3,

    "permissions": [
        "storage",
        "scripting",
        "unlimitedStorage",
        "activeTab"
    ],

    "host_permissions": [
      "https://*.youtube.com/*"
    ],

    "action": {
        "default_popup": "popup.html",
        "default_title": "Final Project",
        "default_icon": "images/hello_extensions.png"
    },

    "icons": {
            "16": "images/icon-16.png",
            "32": "images/icon-32.png",
            "48": "images/icon-48.png",
            "128": "images/icon-128.png"
    },

    "content_scripts": [
        {
            "matches": ["https://*.youtube.com/*"],
            "js": ["scripts/content.js"]
        }
    ],

    "background": {
        "service_worker": "scripts/background.js",
        "type": "module"
    },

    "web_accessible_resources": [
    {
      "resources": [
        "assets/bookmark.png",
        "assets/play.png",
        "assets/delete.png",
        "assets/save.png"
      ],
      "matches": ["https://*.youtube.com/*"]
    }
  ]
}
